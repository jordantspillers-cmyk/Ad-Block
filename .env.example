# Copy to .env and edit. scripts/install.sh creates this for you.

# Your time zone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/New_York

# Password for the web dashboard at http://<this-machine-ip>:8080/admin
WEB_PASSWORD=change-me

# Port for the web dashboard
WEB_PORT=8080

# Upstream DNS servers (semicolon separated). Defaults to Quad9, which also
# blocks known malware domains. Alternatives:
#   Cloudflare (malware filtering): "1.1.1.2;1.0.0.2"
#   Google:                        "8.8.8.8;8.8.4.4"
UPSTREAM_DNS="9.9.9.9;149.112.112.112"

# Which blocklist profile scripts/apply-lists.sh loads: standard | aggressive
# standard   = ads, trackers, malware, smart-TV/phone telemetry (recommended)
# aggressive = standard + extra lists; blocks more, but expect occasional breakage
BLOCK_PROFILE=standard

# --- Only used by docker-compose.dhcp.yml (Pi-hole as DHCP server) ---
# DHCP_START=192.168.1.100
# DHCP_END=192.168.1.250
# DHCP_ROUTER=192.168.1.1
# DHCP_NETMASK=255.255.255.0
